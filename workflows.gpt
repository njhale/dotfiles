Name: Open Webpages
Description: Opens a set of HTTP or HTTPS webpage URLs as tabs in a new default browser window
Param: urls: A space-delimited set of HTTP or HTTPS URLs to open

#!python3

import os
import webbrowser

def open_webpages():
  try:
    urls = os.getenv('URLS').split()
  except AttributeError:
    raise ValueError("Environment variable 'URLS' is not set or is empty.")
  except Exception as e:
    raise Exception(f"An unexpected error occurred: {e}")

  if urls is None or len(urls) < 1:
    raise ValueError("No webpage URLs open")

  exceptions = []
  new_window_opened = false
  for url in url_list:
    try:
      if !new_window_opened:
        # Open a new window first so we don't make a mess of existing tabs
        webbrowser.open_new(url)
        opened = true
      else:
        webbrowser.open_new_tab(url)

      print(f"{url} successfully opened in browser")
    except Exception as e:
      exceptions.append(f"Failed to open {url}: {str(e)}")

    if len(exceptions) > 0:
      raise Exception("\n".join(exceptions))

    print("successfully opened all webpages")

open_webpages()

